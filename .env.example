# Copy to .env.local and adjust. Never commit .env.local.
# NEXT_PUBLIC_* variables are exposed to the browser; the rest only to the server.

# --- Supabase (the app only ever uses the anon key; RLS enforces access) ---
# LOCAL: values printed by `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HOSTED: Project Settings > API
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- scripts/create-users.mjs only (NOT used by the app) ---
# Admin API needs the service-role key. Local: `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# Password set on the seeded test users (director@afa.gt, etc.).
TEST_PASSWORD=
# SUPABASE_URL=   # defaults to NEXT_PUBLIC_SUPABASE_URL / local
